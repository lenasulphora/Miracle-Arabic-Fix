<Window x:Class="Miracle.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shortcuts" Height="520" Width="432" MinWidth="432" MinHeight="430"
        ResizeMode="CanResize" Background="Transparent"
        Foreground="{StaticResource B_Text}" Topmost="True" WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" FontFamily="Segoe UI Variable Text, Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="18" GlassFrameThickness="0" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- ============ Key button ============ -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1B1B23"/>
            <Setter Property="Foreground" Value="{StaticResource B_Text}"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="9"
                                BorderBrush="#2C2C38" BorderThickness="1.2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource B_Accent}"/>
                                <Setter TargetName="border" Property="Background" Value="#23232F"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2E1F45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Primary button (SAVE) ============ -->
        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bg" CornerRadius="10" Background="{StaticResource B_AccentGrad}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#A855F7" BlurRadius="14" ShadowDepth="0" Opacity="0.42"/>
                                </Border.Effect>
                            </Border>
                            <Border CornerRadius="10" Background="{StaticResource B_Sheen}" IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Text field (used from code: MiracleInputStyle) ============ -->
        <Style x:Key="MiracleInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#12121A"/>
            <Setter Property="Foreground" Value="{StaticResource B_Text}"/>
            <Setter Property="BorderBrush" Value="#2C2C38"/>
            <Setter Property="CaretBrush" Value="{StaticResource B_Accent}"/>
            <Setter Property="SelectionBrush" Value="#66A855F7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bdr" CornerRadius="9" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.2">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="9,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bdr" Property="BorderBrush" Value="#3A3A4C"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bdr" Property="BorderBrush" Value="{StaticResource B_Accent}"/>
                                <Setter TargetName="Bdr" Property="Background" Value="#16161F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Multiline text field variant ============ -->
        <!-- Same template, but top-aligned with padding so a wrapped macro stays readable; the single-line version centers its host and clips the first Arabic line. -->
        <Style x:Key="MiracleEditorStyle" TargetType="TextBox" BasedOn="{StaticResource MiracleInputStyle}">
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bdr" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.4" Padding="11,9,11,11">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Top"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bdr" Property="BorderBrush" Value="#3A3A4C"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bdr" Property="BorderBrush" Value="{StaticResource B_Accent}"/>
                                <Setter TargetName="Bdr" Property="Background" Value="#16161F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
<!-- ============ Target window shortcuts toggle box ============ -->
        <Style x:Key="GlowCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="IndicatorBox" Width="22" Height="22" CornerRadius="7"
                                Background="#131319" BorderBrush="#2A2A36" BorderThickness="1.5">
                            <Grid>
                                <Ellipse x:Name="GlowIndicator" Fill="{StaticResource B_Accent}" Margin="5" Opacity="0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#A855F7" BlurRadius="8" ShadowDepth="0" Opacity="0.95"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="IndicatorBox" Property="BorderBrush" Value="{StaticResource B_Accent}"/>
                                <Setter TargetName="GlowIndicator" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IndicatorBox" Property="BorderBrush" Value="{StaticResource B_AccentSoft}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="IndicatorBox" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="IndicatorBox" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ==================== Layout ==================== -->
    <Border CornerRadius="18" Background="{StaticResource B_WindowBg}" BorderThickness="1.4"
            MouseLeftButtonDown="Window_MouseDown">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#3E3E4E" Offset="0"/>
                <GradientStop Color="#26263A" Offset="0.45"/>
                <GradientStop Color="#8B5CF6" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="5" Opacity="0.6"/>
        </Border.Effect>
        <Grid>
            <Ellipse Width="300" Height="150" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-65,-65,0,0" Fill="{StaticResource B_Bloom}" IsHitTestVisible="False"/>
            <Grid Margin="18,15,18,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- ============ Editor card ============ -->
                <Border x:Name="EditorPanel" Grid.Column="0" Visibility="Collapsed" Width="322" CornerRadius="13" Background="{StaticResource B_Card}" BorderThickness="1.2"
                        Margin="0,0,13,0">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#3B2757" Offset="0"/>
                            <GradientStop Color="#1E1E27" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Grid Margin="13,10,13,11">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="L_EditorTitle" Text="EDIT MACRO" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource B_TextDim}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="L_EditorIndex" Text="" FontSize="9" Foreground="#A3A3B2"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="Btn_ClosePanel" Content="←" Width="26" Height="26" Margin="0,0,5,0"
                                        FontSize="14" Foreground="#9A9AA8" Background="#17171F" BorderBrush="#2C2C38"
                                        Click="ClosePanel_Click" ToolTip="Close editor"/>
                                <Button x:Name="Btn_Delete" Content="✕" Width="30" Height="26"
                                        FontSize="11" Foreground="#D8B4FE" Background="#21182D" BorderBrush="#49345F"
                                        Click="DeleteRow_Click">
                                    <Button.ToolTip><ToolTip x:Name="TT_Delete"/></Button.ToolTip>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="EditorKeys" Grid.Column="0" Orientation="Horizontal"/>
                            <TextBlock x:Name="L_Chars" Grid.Column="1" Text="" FontSize="8.5" Foreground="#A3A3B2"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,11,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="L_KeepTextAsWritten" Text="SEND AS WRITTEN" FontSize="9"
                                               FontWeight="Bold" Foreground="#D8B4FE"/>
                                <TextBlock x:Name="L_KeepTextHint" Text="Skip Arabic shaping for this macro"
                                               FontSize="8" Foreground="#A99AB9" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkKeepTextAsWritten" Grid.Column="1" Style="{StaticResource GlowCheck}"
                                      AutomationProperties.Name="Send macro as written"
                                      VerticalAlignment="Center" Click="KeepTextAsWritten_Click"/>
                        </Grid>

                        <TextBox x:Name="MacroEditor" Grid.Row="3" Style="{StaticResource MiracleEditorStyle}" Margin="0,9,0,0"
                                 MinHeight="150" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" FontSize="12.5" FlowDirection="RightToLeft"
                                 TextAlignment="Left" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 TextChanged="MacroEditor_TextChanged"/>
                    </Grid>
                </Border>

                <Grid x:Name="MainCol" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ============ Header ============ -->
                <Grid Grid.Row="0" Margin="0,0,0,13">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="8" Background="{StaticResource B_AccentGrad}">
                            <Border.Effect>
                                <DropShadowEffect Color="#A855F7" BlurRadius="11" ShadowDepth="0" Opacity="0.55"/>
                            </Border.Effect>
                            <TextBlock Text="⌘" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="Txt_Header" Text="HOTKEYS CONFIGURATION" FontSize="12.5"
                                   FontWeight="Bold" Foreground="#F4F4F5" VerticalAlignment="Center"
                                   Margin="9,0,0,0"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Width="28"
                            Height="24" FontSize="10" Click="Cancel_Click" Background="Transparent"
                            Foreground="#7E7E8C"/>
                </Grid>
<!-- ============ Target window shortcuts card ============ -->
                <Border Grid.Row="1" CornerRadius="12" Background="{StaticResource B_Card}" BorderThickness="1"
                        BorderBrush="#23232E" Padding="13,10" Margin="0,0,0,12">
                    <DockPanel>
                        <CheckBox x:Name="BtnGlobalToggle" Style="{StaticResource GlowCheck}"
                                  AutomationProperties.Name="Target window shortcuts">
                            <CheckBox.ToolTip>
                                <ToolTip x:Name="GlobalToolTip" Placement="Bottom" HorizontalOffset="-10" VerticalOffset="10"/>
                            </CheckBox.ToolTip>
                        </CheckBox>
                        <TextBlock x:Name="L_GlobalTitle" Text="TARGET WINDOW SHORTCUTS SUPPORT" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource B_TextDim}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>

                <!-- ============ Macro list ============ -->
                <TextBlock x:Name="L_Conflict" Grid.Row="2" Text="" Visibility="Collapsed"
                           Foreground="#D8B4FE" FontSize="9.5" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="2,0,2,8" AutomationProperties.LiveSetting="Assertive"/>

                <Border Grid.Row="3" CornerRadius="12" Background="#0B0B10" BorderThickness="1"
                        BorderBrush="#1E1E27" Padding="6,5">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ShortcutContainer"/>
                    </ScrollViewer>
                </Border>

                <!-- ============ Sticky footer ============ -->
                <Grid Grid.Row="4" Margin="0,12,0,0">
                    <TextBlock x:Name="L_Dirty" Text="" Foreground="#F59E0B" FontSize="9" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <UniformGrid Columns="3" HorizontalAlignment="Right" Width="300">
                        <Button x:Name="Btn_Add" Content="+ NEW" Height="34" Margin="0,0,4,0" FontSize="10"
                                Click="AddRow_Click"/>
                        <Button x:Name="Btn_Cancel" Content="CLOSE" Height="34" Margin="4,0,4,0" FontSize="10"
                                Click="Cancel_Click"/>
                        <Button x:Name="Btn_Save" Content="SAVE" Height="34" Margin="4,0,0,0"
                                Style="{StaticResource SaveBtn}" Click="Save_Click"/>
                    </UniformGrid>
                </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>