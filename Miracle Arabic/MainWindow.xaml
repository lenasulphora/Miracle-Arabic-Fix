<Window x:Class="Miracle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Miracle | Arabic Fix" Height="160" Width="400" MinWidth="372" MinHeight="112"
        Background="Transparent" Foreground="#F4F4F5" WindowStyle="None" AllowsTransparency="True"
        Topmost="True" WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="18" GlassFrameThickness="0" ResizeBorderThickness="8"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- ============ Feature toggles (EASY / CORRECT / TRANSLATE) ============ -->
        <Style x:Key="ModernToggle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Background" Value="#12121A"/>
            <Setter Property="Foreground" Value="#7A7A88"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Height" Value="22"/>
            <!-- The three feature pills use one exact width so that
                 EASY / CORRECT / TRANSLATE read as one unified group. -->
            <Setter Property="Width" Value="84"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Grid>
                            <Border x:Name="bg" CornerRadius="9" Background="{TemplateBinding Background}"
                                    BorderBrush="#22222C" BorderThickness="1"/>
                            <Border x:Name="sheen" CornerRadius="9" Background="{StaticResource B_Sheen}"
                                    IsHitTestVisible="False" Opacity="0"/>
                            <Border x:Name="glow" CornerRadius="9" BorderThickness="1.3" Opacity="0" IsHitTestVisible="False"
                                    BorderBrush="{Binding Tag, RelativeSource={RelativeSource Mode=TemplatedParent}}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Margin="9,0">
                                <Ellipse x:Name="dot" Width="5" Height="5" Fill="#4A4A56" Margin="0,0,6,0"
                                         VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1C1C26"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#33333F"/>
                                <Setter Property="Foreground" Value="#D4D4DC"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background"
                                        Value="{Binding Tag, RelativeSource={RelativeSource Mode=TemplatedParent}}"/>
                                <Setter TargetName="sheen" Property="Opacity" Value="1"/>
                                <Setter TargetName="glow" Property="Opacity" Value="0.55"/>
                                <Setter TargetName="dot" Property="Fill" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="sheen" Property="Opacity" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#A855F7" BlurRadius="14" ShadowDepth="0" Opacity="0.5"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
<!-- ============ Icon button (settings gear) ============ -->
        <Style x:Key="IconBtn" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#14141C"/>
            <Setter Property="Foreground" Value="#9A9AA8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ib" CornerRadius="9" Background="{TemplateBinding Background}"
                                BorderBrush="#25252F" BorderThickness="1.1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ib" Property="BorderBrush" Value="{StaticResource B_Accent}"/>
                                <Setter TargetName="ib" Property="Background" Value="#1E1B2A"/>
                                <Setter Property="Foreground" Value="{StaticResource B_AccentSoft}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ib" Property="Background" Value="#2A2440"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Window controls ============ -->
        <Style x:Key="WinBtn" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#7E7E8C"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bg" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1E1E28"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2A2A36"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtn" TargetType="{x:Type Button}" BasedOn="{StaticResource WinBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bg" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#3A1414"/>
                                <Setter Property="Foreground" Value="#FF6B63"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#4A1919"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Clear pill ============ -->
        <Style x:Key="GhostPill" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#9A9AA8"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bg" CornerRadius="8" Background="#13131B" BorderBrush="#242430" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="9,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2A1416"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#5C2426"/>
                                <Setter Property="Foreground" Value="#FF6B63"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#34181A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
<!-- ==================== Layout ==================== -->
    <Border x:Name="Shell" CornerRadius="18" Background="{StaticResource B_WindowBg}"
            BorderThickness="1.4" MouseLeftButtonDown="Window_MouseDown">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#3E3E4E" Offset="0"/>
                <GradientStop Color="#26263A" Offset="0.4"/>
                <GradientStop Color="#8B5CF6" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="5" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <!-- Accent bloom behind the header -->
            <Ellipse Width="320" Height="150" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-70,-70,0,0" Fill="{StaticResource B_Bloom}" IsHitTestVisible="False"/>

            <!-- Balanced margins: a tighter shell border gives the inner rows breathing room
                 (title <-> pills 10px, pills <-> input 12px) while keeping the same total height. -->
            <Grid Margin="16,6,16,7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ============ Header: identity + window buttons ============ -->
                <!-- Deliberately short (22px logo, no extra padding): every pixel saved here is won by the text. -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="7" Background="{StaticResource B_AccentGrad}"
                                VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#A855F7" BlurRadius="12" ShadowDepth="0" Opacity="0.55"/>
                            </Border.Effect>
                            <TextBlock Text="✦" FontSize="11" Foreground="#FFFFFF" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="MIRACLE" FontSize="11.5" FontWeight="Bold" Foreground="#F4F4F5"
                                       VerticalAlignment="Center" TextOptions.TextFormattingMode="Ideal"/>
                            <TextBlock Text="ARABIC" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource B_Accent}"
                                       Margin="4,0,0,0" VerticalAlignment="Center" TextOptions.TextFormattingMode="Ideal"/>
                            <TextBlock x:Name="VerTag" Text="v1.4.1" FontSize="8.5" Foreground="#5C5C68"
                                       Margin="6,1,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="—" Width="26" Height="21" Style="{StaticResource WinBtn}"
                                Click="Minimize_Click" ToolTip="Minimize"/>
                        <Button Content="✕" Width="26" Height="21" Margin="3,0,0,0" Style="{StaticResource CloseBtn}"
                                Click="Close_Click" ToolTip="Hide to tray"/>
                    </StackPanel>
                </Grid>

                <!-- ============ Toolbar ============ -->
                <!-- Toolbar: feature pills on the left, settings on the right. -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <ToggleButton x:Name="BtnEasy" Tag="#A855F7" Style="{StaticResource ModernToggle}">
                            <ToggleButton.ToolTip><ToolTip x:Name="TT_Easy"/></ToggleButton.ToolTip>
                            <TextBlock Text="EASY"/>
                        </ToggleButton>
                        <ToggleButton x:Name="BtnCorrect" Tag="#3B82F6" Margin="5,0,0,0" Style="{StaticResource ModernToggle}">
                            <ToggleButton.ToolTip><ToolTip x:Name="TT_Correct"/></ToggleButton.ToolTip>
                            <TextBlock Text="CORRECT"/>
                        </ToggleButton>
                        <ToggleButton x:Name="BtnTranslate" Tag="#F59E0B" Margin="5,0,0,0" Style="{StaticResource ModernToggle}"
                                      Click="ToggleTranslate_Click">
                            <ToggleButton.ToolTip><ToolTip x:Name="TT_Translate"/></ToggleButton.ToolTip>
                            <TextBlock Text="TRANSLATE"/>
                        </ToggleButton>
                        <Button Content="CLEAR" Height="22" Margin="6,0,0,0" Style="{StaticResource GhostPill}"
                                Click="Clear_Click">
                            <Button.ToolTip><ToolTip x:Name="TT_Clear"/></Button.ToolTip>
                        </Button>
                        <!-- Shown only when a message was pasted in the game but delivery is
                             unconfirmed: the text is kept aside for manual restore, never re-sent. -->
                        <Button x:Name="RestorePill" Height="22" Margin="6,0,0,0" Style="{StaticResource GhostPill}"
                                Click="Restore_Click" Visibility="Collapsed">
                            <Button.ToolTip><ToolTip x:Name="TT_Restore"/></Button.ToolTip>
                            <TextBlock x:Name="RestorePillText" Text="RESTORE"/>
                        </Button>
                    </StackPanel>

                    <!-- ===== Window / shortcut buttons (same row, far right) ===== -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Width="30" Height="26" Style="{StaticResource IconBtn}" Click="OpenSettings_Click"
                                ToolTip="Settings" Content="⚙" FontSize="12.5"/>
                    </StackPanel>
                </Grid>

                <!-- ============ Input card ============ -->
                <Grid Grid.Row="2">
                    <Border x:Name="InBoxBorder" CornerRadius="13" BorderThickness="1.3" Background="{StaticResource B_Card}">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#33333F" Offset="0"/>
                                <GradientStop Color="#1A1A22" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Grid>
                        <!-- The inner padding below is optically centered (11 top / 10 bottom)
                             against the line box itself instead of leaving dead space under the text. -->
                        <TextBox x:Name="InBox" Background="Transparent" Foreground="#F4F4F5" BorderThickness="0"
                                 Padding="13,7,13,6" MinHeight="34" FontSize="22" AcceptsReturn="True" TextWrapping="Wrap"
                                 FlowDirection="RightToLeft" TextAlignment="Left" VerticalContentAlignment="Top"
                                 TextChanged="InBox_TextChanged" PreviewKeyDown="InBox_PreviewKeyDown"
                                 VerticalScrollBarVisibility="Auto" CaretBrush="#A855F7"
                                 SelectionBrush="#66A855F7" SpellCheck.IsEnabled="False" FontFamily="Segoe UI"/>

                        <!-- Focus glow, driven from code-behind -->
                        <Border x:Name="InGlow" CornerRadius="13" BorderThickness="1.6" IsHitTestVisible="False"
                                BorderBrush="{StaticResource B_Accent}" Opacity="0">
                            <Border.Effect>
                                <DropShadowEffect Color="#A855F7" BlurRadius="13" ShadowDepth="0" Opacity="0.5"/>
                            </Border.Effect>
                        </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============ Preview card ============ -->
                <Border x:Name="OutBorder" Grid.Row="3" CornerRadius="12" Background="{StaticResource B_PreviewCard}"
                        BorderThickness="1.2" Margin="0,7,0,0" MaxHeight="112">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4A2E7A" Offset="0"/>
                            <GradientStop Color="#241942" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,7,12,0">
                            <TextBlock Text="◈" FontSize="9" Foreground="#8B5CF6" VerticalAlignment="Center"/>
                            <TextBlock Text="PREVIEW" FontSize="8.5" FontWeight="Bold" Foreground="#7C7C8E"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,0,6">
                            <TextBlock x:Name="OutBox" Padding="13,5,13,4" Foreground="#D8B4FE" MinHeight="34"
                                       FontSize="21" FlowDirection="RightToLeft" TextAlignment="Left" TextWrapping="Wrap"
                                       FontFamily="Segoe UI"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- ============ Footer ============ -->
                <Grid x:Name="FooterArea" Grid.Row="4" Margin="0,7,0,0">
                    <TextBlock Text="DEVELOPED BY LENA" Foreground="#3F3F46" FontSize="9" FontWeight="Black"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="✦" Foreground="#2E2E3A" FontSize="9" HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Grid>
<!-- ============ Floating toast ============ -->
            <Border x:Name="ToastHost" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"
                    CornerRadius="11" Background="#F01A1224" BorderThickness="1.2" Padding="15,8"
                    Opacity="0" IsHitTestVisible="False">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#7C3AED" Offset="0"/>
                        <GradientStop Color="#3B82F6" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.7"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToastIcon" Text="✦" FontSize="11" Foreground="{StaticResource B_AccentSoft}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="ToastText" Text="COPIED ✔" FontSize="10" FontWeight="Bold"
                               Foreground="#F4F4F5" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>


