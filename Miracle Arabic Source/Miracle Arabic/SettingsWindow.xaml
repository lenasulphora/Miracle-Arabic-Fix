<Window x:Class="Miracle.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="392" Height="486" MinWidth="360" MinHeight="420"
        ResizeMode="CanResize" Background="Transparent"
        Foreground="{StaticResource B_Text}" Topmost="True" WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="18" GlassFrameThickness="0" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- ============ Section label ============ -->
        <Style x:Key="SecLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource B_TextDim}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="2,0,0,5"/>
        </Style>

        <!-- ============ Card ============ -->
        <Style x:Key="Card" TargetType="{x:Type Border}">
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Background" Value="{StaticResource B_Card}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#22222C"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <!-- ============ Primary button ============ -->
        <Style x:Key="PrimaryBtn" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Border x:Name="bg" CornerRadius="10" Background="{StaticResource B_AccentGrad}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#A855F7" BlurRadius="14" ShadowDepth="0" Opacity="0.42"/>
                                </Border.Effect>
                            </Border>
                            <Border CornerRadius="10" Background="{StaticResource B_Sheen}" IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Secondary button (Ghost) ============ -->
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#16161E"/>
            <Setter Property="Foreground" Value="{StaticResource B_Text}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10"
                                BorderBrush="#25252F" BorderThickness="1.1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource B_Accent}"/>
                                <Setter TargetName="border" Property="Background" Value="#1E1E2A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A2A38"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
<!-- ============ Link button ============ -->
        <Style x:Key="LinkBtn" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource B_TextDim}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="Transparent" Padding="6,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource B_AccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Checkbox ============ -->
        <Style x:Key="ModernCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource B_Text}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="IndicatorBox" Width="20" Height="20" CornerRadius="6"
                                    Background="#131319" BorderBrush="#2A2A36" BorderThickness="1.5">
                                <Grid>
                                    <Ellipse x:Name="GlowIndicator" Fill="{StaticResource B_Accent}" Margin="4.5" Opacity="0">
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#A855F7" BlurRadius="7" ShadowDepth="0" Opacity="0.9"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                </Grid>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="IndicatorBox" Property="BorderBrush" Value="{StaticResource B_Accent}"/>
                                <Setter TargetName="GlowIndicator" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IndicatorBox" Property="BorderBrush" Value="{StaticResource B_AccentSoft}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="IndicatorBox" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="IndicatorBox" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Dropdown list ============ -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#14141C"/>
            <Setter Property="Foreground" Value="{StaticResource B_Text}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="PART_Toggle" Background="{TemplateBinding Background}"
                                          BorderBrush="#252530" BorderThickness="1.1" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="cb" CornerRadius="9" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <Path Data="M0,0 L4,4 L8,0 Z" Fill="{StaticResource B_Accent}"
                                                  HorizontalAlignment="Right" Margin="0,0,11,0" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="cb" Property="BorderBrush" Value="{StaticResource B_Accent}"/>
                                                <Setter TargetName="cb" Property="Background" Value="#1C1C28"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="12,0,26,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBox x:Name="PART_EditableTextBox" VerticalAlignment="Center" Margin="11,0,26,0"
                                     Focusable="True" Background="Transparent" Foreground="{StaticResource B_Text}"
                                     CaretBrush="{StaticResource B_Accent}" BorderThickness="0"
                                     Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                                   PopupAnimation="Fade" Focusable="False">
                                <Border Background="#12121A" BorderBrush="#2A2A38" BorderThickness="1.2" CornerRadius="10"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="220" Margin="0,4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.65"/>
                                    </Border.Effect>
                                    <ScrollViewer><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource B_Text}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ib" Background="Transparent" CornerRadius="7" Margin="3,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ib" Property="Background" Value="#22222E"/>
                                <Setter Property="Foreground" Value="{StaticResource B_AccentSoft}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ib" Property="Background" Value="#2A1C3D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Password box ============ -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#14141C"/>
            <Setter Property="Foreground" Value="{StaticResource B_Text}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="CaretBrush" Value="{StaticResource B_Accent}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="pb" CornerRadius="9" Background="{TemplateBinding Background}"
                                BorderBrush="#252530" BorderThickness="1.1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="11,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pb" Property="BorderBrush" Value="#35354A"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="pb" Property="BorderBrush" Value="{StaticResource B_Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="LanguageItem">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding Flag}" Width="20" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"
                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!-- ==================== Layout ==================== -->
    <Border CornerRadius="18" Background="{StaticResource B_WindowBg}" BorderThickness="1.4"
            MouseLeftButtonDown="Window_MouseDown">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#3E3E4E" Offset="0"/>
                <GradientStop Color="#26263A" Offset="0.45"/>
                <GradientStop Color="#8B5CF6" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="5" Opacity="0.6"/>
        </Border.Effect>
        <Grid>
            <Ellipse Width="290" Height="140" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-60,-60,0,0" Fill="{StaticResource B_Bloom}" IsHitTestVisible="False"/>
            <Grid Margin="15,12,15,13">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
<!-- ============ Header ============ -->
                <Grid Grid.Row="0" Margin="0,0,0,11">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="8" Background="{StaticResource B_AccentGrad}">
                            <Border.Effect>
                                <DropShadowEffect Color="#A855F7" BlurRadius="11" ShadowDepth="0" Opacity="0.55"/>
                            </Border.Effect>
                            <TextBlock Text="⚙" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="L_Title" Text="SETTINGS" FontSize="13" FontWeight="Bold"
                                       Foreground="#F4F4F5" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtVersion" Text="v1.4.1" Foreground="#4A4A56" FontSize="9.5"
                                       Margin="7,1,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="L_Update" Content="Check Update ↻" Click="CheckUpdate_Click"
                                Style="{StaticResource LinkBtn}"/>
                        <Button Content="✕" Width="28" Height="24" Margin="6,0,0,0" FontSize="10"
                                Click="Cancel_Click" Background="Transparent" Foreground="#7E7E8C"/>
                    </StackPanel>
                </Grid>
                <!-- ============ Tab bar ============ -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="TabGeneral" Grid.Column="0" Content="GENERAL" Height="32" Margin="0,0,4,0"
                            FontSize="10.5" FontWeight="Bold" Click="TabGeneral_Click"/>
                    <Button x:Name="TabTranslate" Grid.Column="1" Content="TRANSLATION" Height="32" Margin="4,0,4,0"
                            FontSize="10.5" FontWeight="Bold" Click="TabTranslate_Click"/>
                    <Button x:Name="TabShortcuts" Grid.Column="2" Content="SHORTCUTS" Height="32" Margin="4,0,0,0"
                            FontSize="10.5" FontWeight="Bold" Click="TabShortcuts_Click"/>
                </Grid>
                <!-- ============ Panel content ============ -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <StackPanel x:Name="PanelGeneral">
                    <!-- ============ Card: target window ============ -->
                    <TextBlock Text="TARGET WINDOW" Style="{StaticResource SecLabel}"/>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ComboWin" IsEditable="True" Grid.Column="0" Margin="0,0,7,0">
                                <ComboBox.ToolTip><ToolTip x:Name="TT_TargetWin"/></ComboBox.ToolTip>
                            </ComboBox>
                            <Button Grid.Column="1" Content="↻" Width="34" Height="32" Margin="0,0,6,0"
                                    FontSize="13" Click="Refresh_Click">
                                <Button.ToolTip><ToolTip x:Name="TT_Refresh"/></Button.ToolTip>
                            </Button>
                            <Button Grid.Column="2" Content="🔗" Width="34" Height="32" FontSize="12"
                                    Click="Shortcut_Click">
                                <Button.ToolTip><ToolTip x:Name="TT_ShortcutGame"/></Button.ToolTip>
                            </Button>
                        </Grid>
                    </Border>
                    <!-- ============ Card: fonts ============ -->
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock x:Name="L_FontSize" Text="FONT SIZE" Style="{StaticResource SecLabel}"/>
                                <ComboBox x:Name="ComboFS">
                                    <ComboBoxItem Content="14"/>
                                    <ComboBoxItem Content="18"/>
                                    <ComboBoxItem Content="22"/>
                                    <ComboBoxItem Content="28"/>
                                    <ComboBoxItem Content="36"/>
                                    <ComboBoxItem Content="48"/>
                                    <ComboBoxItem Content="72"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock x:Name="L_TypingSpeed" Text="TYPING SPEED" Style="{StaticResource SecLabel}"/>
                                <ComboBox x:Name="ComboSpeed">
                                    <ComboBox.ToolTip><ToolTip x:Name="TT_Speed"/></ComboBox.ToolTip>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- ============ Card: interface ============ -->
                    <TextBlock x:Name="L_InterfaceLang" Text="INTERFACE LANGUAGE" Style="{StaticResource SecLabel}"/>
                    <Border Style="{StaticResource Card}">
                        <ComboBox x:Name="ComboLang" SelectionChanged="ComboLang_SelectionChanged">
                            <ComboBoxItem Content="English" Tag="EN"/>
                            <ComboBoxItem Content="العربية" Tag="AR"/>
                        </ComboBox>
                    </Border>
                    <!-- ============ Card: Arabic direction / MINI ============ -->
                    <Border Style="{StaticResource Card}" Padding="13,12">
                        <StackPanel>
                            <CheckBox x:Name="ChkAutoArabic" Style="{StaticResource ModernCheck}">
                                <CheckBox.ToolTip><ToolTip x:Name="TT_AutoArabic"/></CheckBox.ToolTip>
                            </CheckBox>
                            <Rectangle Height="1" Fill="#1E1E28" Margin="0,11"/>
                            <CheckBox x:Name="ChkMini" Style="{StaticResource ModernCheck}" Click="ChkMini_Click">
                                <CheckBox.ToolTip><ToolTip x:Name="TT_Mini"/></CheckBox.ToolTip>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                    <!-- ============ Card: Easy Mode transport ============ -->
                    <TextBlock x:Name="L_SendMode" Text="EASY MODE SENDING" Style="{StaticResource SecLabel}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                        <ComboBox x:Name="ComboSendMode" SelectionChanged="ComboSendMode_SelectionChanged">
                            <ComboBox.ToolTip><ToolTip x:Name="TT_SendMode"/></ComboBox.ToolTip>
                        </ComboBox>
                        </StackPanel>
                    </Border>
                        </StackPanel>
                        <StackPanel x:Name="PanelTranslate" Visibility="Collapsed">
                        <TextBlock x:Name="L_Translator" Text="TRANSLATOR" Style="{StaticResource SecLabel}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                            <ComboBox x:Name="ComboTranslator" SelectionChanged="ComboTranslator_SelectionChanged">
                                <ComboBox.ToolTip><ToolTip x:Name="TT_Translator"/></ComboBox.ToolTip>
                                <ComboBoxItem Content="Google" Tag="Google"/>
                                <ComboBoxItem Content="DeepL" Tag="DeepL"/>
                            </ComboBox>

                            <Grid x:Name="DeepLPanel" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="TxtDeepLKey" Grid.Column="0" Height="32">
                                    <PasswordBox.ToolTip><ToolTip x:Name="TT_DeepLKey"/></PasswordBox.ToolTip>
                                </PasswordBox>
                                <Button x:Name="BtnDeepLCheck" Grid.Column="1" Content="✓" Width="42" Height="32"
                                        Margin="6,0,0,0" Click="DeepLCheck_Click" FontSize="14" FontWeight="Bold"
                                        Foreground="#10B981">
                                    <Button.ToolTip><ToolTip x:Name="TT_DeepLCheck"/></Button.ToolTip>
                                </Button>
                                <Button x:Name="BtnDeepLFree" Grid.Column="2" Content="FREE KEY" Height="32"
                                        Margin="6,0,0,0" Padding="9,0" FontSize="8.5" FontWeight="Bold"
                                        Click="DeepLFree_Click" Background="#2A1C3D" Foreground="#D8B4FE"
                                        BorderBrush="#41275E">
                                    <Button.ToolTip><ToolTip x:Name="TT_DeepLFree"/></Button.ToolTip>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="L_DeepLStatus" Text="" Foreground="#10B981" FontSize="9"
                                       FontWeight="Bold" Margin="2,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
<!-- ============ Card: translation ============ -->
                    <TextBlock x:Name="L_Translate" Text="TRANSLATE" Style="{StaticResource SecLabel}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="ComboSrc" Grid.Column="0" ItemTemplate="{StaticResource LanguageItem}"
                                          Margin="0,0,6,0">
                                    <ComboBox.ToolTip><ToolTip x:Name="TT_Src"/></ComboBox.ToolTip>
                                </ComboBox>
                                <Button x:Name="BtnSwap" Grid.Column="1" Content="⇄" Width="34" Height="32"
                                        Margin="0,0,6,0" Click="SwapLangs_Click" FontSize="13">
                                    <Button.ToolTip><ToolTip x:Name="TT_Swap"/></Button.ToolTip>
                                </Button>
                                <ComboBox x:Name="ComboDst" Grid.Column="2" ItemTemplate="{StaticResource LanguageItem}">
                                    <ComboBox.ToolTip><ToolTip x:Name="TT_Dst"/></ComboBox.ToolTip>
                                </ComboBox>
                            </Grid>
                            <TextBlock x:Name="L_TranslateHint" Foreground="#5A5A66" FontSize="9" TextWrapping="Wrap"
                                       Margin="2,9,2,0"/>

                            <Rectangle Height="1" Fill="#1E1E28" Margin="0,12"/>

                        </StackPanel>
                    </Border>
                        </StackPanel>
                        <StackPanel x:Name="PanelShortcuts" Visibility="Collapsed">
<!-- ============ Shortcuts button ============ -->
                    <Button x:Name="L_HotkeysBtn" Content="⌨ CONFIGURE KEYBOARD HOTKEYS" Height="36"
                            Margin="0,0,0,9" Click="OpenShortcuts_Click" FontSize="10.5" FontWeight="Bold"
                            Foreground="#D8B4FE" Background="#221733" BorderBrush="#3A2554"/>
                    <!-- ============ Card: show / hide ============ -->
                    <TextBlock x:Name="L_ShowHide" Text="SHOW / HIDE HOTKEY" Style="{StaticResource SecLabel}"/>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnHideK1" Grid.Column="0" Width="74" Height="32" FontSize="9.5"
                                    FontWeight="Bold" Margin="0,0,6,0"/>
                            <Button x:Name="BtnHideK2" Grid.Column="1" Width="74" Height="32" FontSize="9.5"
                                    FontWeight="Bold"/>
                            <TextBlock x:Name="L_HideHint" Grid.Column="2" Text="Tool stays in the system tray"
                                       Foreground="#5A5A66" FontSize="9" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="11,0,0,0"/>
                        </Grid>
                    </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,7">
                                <StackPanel>
                                    <TextBlock x:Name="L_ShortcutsHint" TextWrapping="Wrap" FontSize="9.5"
                                               Foreground="#8A8A96" Margin="2,2,2,2"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
                <!-- ============ Sticky footer ============ -->
                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <TextBlock x:Name="L_Dirty" Text="" Foreground="#F59E0B" FontSize="9" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <UniformGrid Columns="2" HorizontalAlignment="Right" Width="230">
                        <Button x:Name="L_Cancel" Content="CANCEL" Height="36" Margin="0,0,4,0" FontSize="11"
                                Click="Cancel_Click"/>
                        <Button x:Name="L_Save" Content="SAVE" Height="36" Margin="4,0,0,0"
                                Style="{StaticResource PrimaryBtn}" Click="Save_Click"/>
                    </UniformGrid>
                </Grid>
