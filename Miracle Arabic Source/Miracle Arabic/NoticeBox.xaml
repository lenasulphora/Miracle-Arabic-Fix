<Window x:Class="Miracle.NoticeBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notice" Width="320" SizeToContent="Height" MaxHeight="420" Background="Transparent"
        Foreground="{StaticResource B_Text}" Topmost="True" WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" FontFamily="Segoe UI Variable Text, Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="16" GlassFrameThickness="0" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>
    <Border CornerRadius="16" Background="{StaticResource B_WindowBg}" BorderThickness="1.3"
            MouseLeftButtonDown="Window_MouseDown">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#42424F" Offset="0"/>
                <GradientStop Color="#26263A" Offset="0.5"/>
                <GradientStop Color="#8B5CF6" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="6" Opacity="0.65"/>
        </Border.Effect>
        <Grid>
            <Ellipse Width="220" Height="110" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-50,-50,0,0" Fill="{StaticResource B_Bloom}" IsHitTestVisible="False"/>
            <Grid Margin="16,14,16,15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
<!-- ============ Header ============ -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,9">
                    <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource B_AccentGrad}"
                            VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="#A855F7" BlurRadius="11" ShadowDepth="0" Opacity="0.55"/>
                        </Border.Effect>
                        <TextBlock x:Name="TxtIcon" Text="◆" FontSize="12" Foreground="#FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TxtTitle" Text="MIRACLE" Foreground="#F4F4F5" FontWeight="Bold"
                               FontSize="12" Margin="9,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- ============ Body ============ -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtMsg" Foreground="#A9A9B6" FontSize="10.5" TextWrapping="Wrap"
                               LineHeight="16" VerticalAlignment="Top"/>
                </ScrollViewer>

                <!-- ============ Buttons ============ -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,13,0,0">
                    <Button x:Name="BtnCancel" Width="78" Height="30" FontSize="10" Click="Cancel_Click"
                            Background="Transparent" Foreground="#8A8A96" Visibility="Collapsed">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="cb" Background="Transparent" CornerRadius="9">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="cb" Property="Background" Value="#1B1B24"/>
                                        <Setter Property="Foreground" Value="#F4F4F5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="BtnDiscard" Width="86" Height="30" FontSize="10" FontWeight="Bold" Margin="0,0,6,0"
                            Click="Discard_Click" Foreground="#FFB020" Background="Transparent"
                            BorderBrush="#5C4210" BorderThickness="1.2" Visibility="Collapsed">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="db" Background="Transparent" CornerRadius="9" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="db" Property="Background" Value="#241A10"/>
                                        <Setter Property="Foreground" Value="#FFC53D"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="BtnOk" Width="86" Height="30" FontSize="10" FontWeight="Bold"
                            Click="Ok_Click" Foreground="#FFFFFF">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Border x:Name="bg" CornerRadius="9" Background="{StaticResource B_AccentGrad}">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#A855F7" BlurRadius="12" ShadowDepth="0"
                                                              Opacity="0.4"/>
                                        </Border.Effect>
                                    </Border>
                                    <Border CornerRadius="9" Background="{StaticResource B_Sheen}"
                                            IsHitTestVisible="False"/>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bg" Property="Opacity" Value="0.75"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>