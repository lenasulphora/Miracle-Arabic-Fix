<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>icon.ico</ApplicationIcon>
		<Product>Miracle Arabic</Product>
		<Description>Arabic text tool for games and chat applications</Description>
		<Copyright>© 2026 Miracle Arabic contributors</Copyright>
		<Company>Miracle Arabic</Company>
		<Version>1.4.1</Version>
		<AssemblyVersion>1.4.1.0</AssemblyVersion>
		<FileVersion>1.4.1.0</FileVersion>
	</PropertyGroup>

	<ItemGroup>
	  <Content Include="icon.ico" />
	</ItemGroup>

	<ItemGroup>
	  <Resource Include="Flags\*.png" />
	</ItemGroup>

	<ItemGroup>
	  <Using Remove="System.Windows.Forms" />
	  <Using Remove="System.Drawing" />
	</ItemGroup>

</Project>