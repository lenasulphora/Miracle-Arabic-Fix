<Application x:Class="Miracle_Arabic.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ==================== Color palette ==================== -->
            <Color x:Key="C_Accent">#A855F7</Color>
            <Color x:Key="C_AccentSoft">#D8B4FE</Color>
            <Color x:Key="C_AccentDeep">#7C3AED</Color>
            <Color x:Key="C_Text">#F4F4F5</Color>
            <Color x:Key="C_TextMuted">#8A8A96</Color>
            <Color x:Key="C_TextDim">#5C5C68</Color>
            <Color x:Key="C_Border">#282833</Color>
            <Color x:Key="C_BorderSoft">#1B1B23</Color>
            <Color x:Key="C_Surface">#0D0D13</Color>
            <Color x:Key="C_Surface2">#15151D</Color>
            <Color x:Key="C_Surface3">#1D1D27</Color>
            <Color x:Key="C_Danger">#FF453A</Color>
            <Color x:Key="C_Success">#10B981</Color>
            <Color x:Key="C_Warn">#F59E0B</Color>
            <Color x:Key="C_Info">#3B82F6</Color>

            <SolidColorBrush x:Key="B_Accent" Color="{StaticResource C_Accent}"/>
            <SolidColorBrush x:Key="B_AccentSoft" Color="{StaticResource C_AccentSoft}"/>
            <SolidColorBrush x:Key="B_AccentDeep" Color="{StaticResource C_AccentDeep}"/>
            <SolidColorBrush x:Key="B_Text" Color="{StaticResource C_Text}"/>
            <SolidColorBrush x:Key="B_TextMuted" Color="{StaticResource C_TextMuted}"/>
            <SolidColorBrush x:Key="B_TextDim" Color="{StaticResource C_TextDim}"/>
            <SolidColorBrush x:Key="B_Border" Color="{StaticResource C_Border}"/>
            <SolidColorBrush x:Key="B_BorderSoft" Color="{StaticResource C_BorderSoft}"/>
            <SolidColorBrush x:Key="B_Surface" Color="{StaticResource C_Surface}"/>
            <SolidColorBrush x:Key="B_Surface2" Color="{StaticResource C_Surface2}"/>
            <SolidColorBrush x:Key="B_Surface3" Color="{StaticResource C_Surface3}"/>
            <SolidColorBrush x:Key="B_Danger" Color="{StaticResource C_Danger}"/>
            <SolidColorBrush x:Key="B_Success" Color="{StaticResource C_Success}"/>

            <!-- Window body -->
            <LinearGradientBrush x:Key="B_WindowBg" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0C0C11" Offset="0"/>
                <GradientStop Color="#101018" Offset="0.55"/>
                <GradientStop Color="#0A0A0F" Offset="1"/>
            </LinearGradientBrush>

            <!-- Card / panel -->
            <LinearGradientBrush x:Key="B_Card" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#13131B" Offset="0"/>
                <GradientStop Color="#0C0C12" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="B_CardSoft" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0F0F16" Offset="0"/>
                <GradientStop Color="#0A0A0F" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="B_PreviewCard" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#100A1B" Offset="0"/>
                <GradientStop Color="#0A0710" Offset="1"/>
            </LinearGradientBrush>

            <!-- Accent color fills -->
            <LinearGradientBrush x:Key="B_AccentGrad" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#B57BFF" Offset="0"/>
                <GradientStop Color="#8B5CF6" Offset="0.55"/>
                <GradientStop Color="#7C3AED" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="B_DangerGrad" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#3A1214" Offset="0"/>
                <GradientStop Color="#26131A" Offset="1"/>
            </LinearGradientBrush>

            <!-- Glowing rim: bright at the top, fading downwards -->
            <LinearGradientBrush x:Key="B_Rim" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#5AA855F7" Offset="0"/>
                <GradientStop Color="#1AA855F7" Offset="0.35"/>
                <GradientStop Color="#00FFFFFF" Offset="1"/>
            </LinearGradientBrush>

            <!-- Sheen layer for buttons and cards -->
            <LinearGradientBrush x:Key="B_Sheen" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1EFFFFFF" Offset="0"/>
                <GradientStop Color="#00FFFFFF" Offset="1"/>
            </LinearGradientBrush>

            <RadialGradientBrush x:Key="B_Bloom" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                <GradientStop Color="#3DA855F7" Offset="0"/>
                <GradientStop Color="#00A855F7" Offset="1"/>
            </RadialGradientBrush>
        <!-- ==================== Tooltip ==================== -->
            <Style TargetType="{x:Type ToolTip}">
                <Setter Property="Foreground" Value="{StaticResource B_Text}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="MaxWidth" Value="330"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToolTip}">
                            <Border CornerRadius="10" BorderThickness="1.2" Padding="11,9" MaxWidth="330">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#17171F" Offset="0"/>
                                        <GradientStop Color="#0E0E14" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#A855F7" Offset="0"/>
                                        <GradientStop Color="#5B3B96" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ==================== Scrollbar ==================== -->
            <Style x:Key="ThinScrollThumb" TargetType="{x:Type Thumb}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Border x:Name="tb" CornerRadius="4" Background="#26262F" Margin="2,1"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="tb" Property="Background" Value="{StaticResource B_Accent}"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="tb" Property="Background" Value="{StaticResource B_AccentSoft}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type ScrollBar}">
                <Setter Property="Width" Value="9"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Border CornerRadius="5" Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ThinScrollThumb}" MinHeight="20"/>
                                    </Track.Thumb>
                                </Track>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="Height" Value="9"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>